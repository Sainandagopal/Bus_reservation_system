# Optional configuration for the single-origin HTTPS app (set in PowerShell before first startup)
MANGO_ADMIN_USERNAME=admin
MANGO_ADMIN_PASSWORD=ReplaceThisWithYourOwnStrongPassword
FRONTEND_ORIGIN=https://localhost:8080
PORT=8080
MANGO_SSL_ENABLED=true
# No Razorpay, UPI, or payment-provider keys are used in this project.
